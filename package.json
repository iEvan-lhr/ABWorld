{
  "name": "luoyang-walk",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node tools/dev.ts",
    "dev:frontend": "node tools/build.ts --dev",
    "dev:backend": "go -C backend run .",
    "test:backend": "go -C backend test ./...",
    "build": "pnpm run typecheck && node tools/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "audit:collision": "node tools/audit-collisions.ts"
  },
  "dependencies": {
    "three": "0.187.0",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/three": "0.183.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "prettier": "3.6.2"
  }
}
